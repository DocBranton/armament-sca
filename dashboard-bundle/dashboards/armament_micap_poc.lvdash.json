{
  "datasets": [
    {
      "name": "ds_armament_parts",
      "displayName": "GAU-8/A sample candidate snapshot (synthetic)",
      "queryLines": [
        "-- PROOF OF CONCEPT ONLY: copied from client/src/lib/data.ts; NOT operational MICAP data.\n",
        "WITH sample AS (\n",
        "  SELECT * FROM VALUES\n",
        "    ('1010-01-234-5678', 'Feed Pawl (Bolt Carrier Subassy)', 4800, 421, 12, 18, 'Obsolescence', -3.2, 0.962, 'CRITICAL', 'High (AM / Re-Eng)'),\n",
        "    ('1010-01-678-9012', 'Barrel Support Bracket', 3600, 365, 8, 22, 'High', -2.7, 0.917, 'CRITICAL', 'High (AM)'),\n",
        "    ('1010-00-583-2210', 'Rotor End Cap', 2900, 298, 7, 36, 'High', -2.1, 0.881, 'HIGH', 'Medium (AM / Repair)'),\n",
        "    ('1010-01-774-3301', 'Trunnion Mount', 2400, 270, 6, 28, 'Medium', -1.8, 0.848, 'HIGH', 'High (AM)'),\n",
        "    ('1010-00-972-4411', 'Drive Shaft Coupling', 2100, 240, 5, 32, 'Medium', -1.6, 0.826, 'HIGH', 'Medium (AM)'),\n",
        "    ('1010-01-118-9922', 'Actuator Housing', 1800, 210, 4, 54, 'Medium', -1.4, 0.788, 'MEDIUM', 'Medium (AM / Repair)'),\n",
        "    ('1010-01-667-1100', 'Feed Gate Guide', 1500, 198, 4, 62, 'Medium', -1.2, 0.764, 'MEDIUM', 'High (AM)'),\n",
        "    ('1010-00-445-8803', 'Worm Gear Cover', 1200, 180, 3, 70, 'Low', -0.9, 0.746, 'MEDIUM', 'Medium (AM)'),\n",
        "    ('1010-01-556-7765', 'Link Ejector Latch', 1100, 176, 3, 68, 'Medium', -0.8, 0.732, 'MEDIUM', 'Medium (AM / Re-Eng)'),\n",
        "    ('1010-00-339-6677', 'Roller Guide', 1000, 168, 3, 74, 'Low', -0.7, 0.721, 'MEDIUM', 'Medium (AM)')\n",
        "  AS p (nsn, part_name, acquisition_cost_usd, lead_time_days, micap_count, annual_demand, supply_risk, readiness_impact_pp, candidate_score, priority, assessment)\n",
        " )\n",
        "SELECT 'GAU-8/A' AS weapon_system, nsn, part_name, acquisition_cost_usd, lead_time_days, micap_count, annual_demand, supply_risk, readiness_impact_pp, candidate_score, priority, assessment FROM sample"
      ]
    }
  ],
  "pages": [
    {
      "name": "analysis",
      "displayName": "Supply Chain Analysis",
      "layout": [
        {
          "widget": {
            "name": "intro",
            "multilineTextboxSpec": {
              "lines": [
                "# Armament Supply Chain | MICAP Analysis\n",
                "**AFLCMC/EBUW · GAU-8/A · SYNTHETIC PROOF OF CONCEPT**\n",
                "Current-state candidate snapshot from `armament-sca`. MICAP count is the supplied sample value, **not** a dated operational trend. Candidate scores are copied, not recalculated."
              ]
            }
          },
          "position": {
            "x": 0,
            "y": 0,
            "width": 12,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "parts",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_armament_parts",
                  "fields": [
                    {
                      "name": "part_count",
                      "expression": "COUNT(*)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "part_count",
                  "displayName": "Parts in Sample"
                }
              },
              "frame": {
                "title": "Parts in Sample",
                "showTitle": true
              }
            }
          },
          "position": {
            "x": 0,
            "y": 3,
            "width": 3,
            "height": 3
          }
        },
        {
          "widget": {
            "name": "micaps",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "ds_armament_parts",
                  "fields": [
                    {
                      "name": "total_micaps",
                      "expression": "SUM(`micap_count`)"
                    }
                  ],
                  "disaggregated": false
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "total_micaps",
                  "displayName": "Sample MICAP Count"
                }
